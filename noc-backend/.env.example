# ══════════════════════════════════════════
# Configuración del Servidor y Base de Datos
# ══════════════════════════════════════════
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contraseña_postgres
DB_NAME=vigia_centinel

# ══════════════════════════════════════════
# Seguridad (Tokens y Claves)
# ══════════════════════════════════════════
# Generar con: node generate_secrets.js
JWT_SECRET=tu_clave_secreta_jwt_min_64_caracteres_aleatorios
WORKER_API_KEY=tu_clave_compartida_backend_ai_worker_aleatoria

# ══════════════════════════════════════════
# Notificaciones Telegram
# ══════════════════════════════════════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ══════════════════════════════════════════
# Notificaciones Email (Gmail App Password)
# ══════════════════════════════════════════
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# ══════════════════════════════════════════
# Políticas de Mantenimiento
# ══════════════════════════════════════════
EVIDENCE_RETENTION_DAYS=30
